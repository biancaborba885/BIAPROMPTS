rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isVerifiedUser() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email is string &&
          request.auth.token.email.lower() in ['biancaborbado123@gmail.com', 'luanasantosarodrigues@gmail.com', 'biancabordado@gmail.com'])
      );
    }

    function emailKeyForAuth() {
      return request.auth.token.email.lower().replace('[^a-z0-9]', '_');
    }

    function hasPreapprovedPurchase() {
      return isVerifiedUser()
        && exists(/databases/$(database)/documents/approved_purchases/$(emailKeyForAuth()))
        && get(/databases/$(database)/documents/approved_purchases/$(emailKeyForAuth())).data.planStatus == 'active'
        && get(/databases/$(database)/documents/approved_purchases/$(emailKeyForAuth())).data.email == request.auth.token.email.lower();
    }

    function hasActiveSubscription() {
      return isAdmin() || (
        isVerifiedUser()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.planStatus == 'active'
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.accessExpiresAt > request.time
      );
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'displayName', 'planStatus', 'accessExpiresAt', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'email', 'displayName', 'planStatus', 'accessExpiresAt', 'createdAt', 'updatedAt'])
        && data.uid is string && isValidId(data.uid)
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100
        && data.planStatus is string && data.planStatus in ['pending', 'active', 'expired']
        && data.accessExpiresAt is timestamp
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidApprovedPurchase(data) {
      return data.keys().hasAll(['email', 'planStatus', 'durationDays', 'grantedBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'planStatus', 'durationDays', 'grantedBy', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && data.planStatus is string && data.planStatus == 'active'
        && data.durationDays is int && data.durationDays >= 1 && data.durationDays <= 3650
        && data.grantedBy is string && isValidId(data.grantedBy)
        && data.createdAt is timestamp;
    }

    function isValidPromptItem(data) {
      return data.keys().hasAll(['title', 'category', 'typeLabel', 'mediaUrl', 'mediaType', 'promptText', 'authorId', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['title', 'category', 'typeLabel', 'mediaUrl', 'mediaType', 'promptText', 'authorId', 'createdAt', 'updatedAt'])
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 120
        && data.category is string && data.category in ['POV', 'UGC', 'Celular', 'Movimentos', 'Feminino', 'Moda', 'Casa', 'Cenários', 'Kids']
        && data.typeLabel is string && data.typeLabel.size() >= 1 && data.typeLabel.size() <= 40
        && data.mediaUrl is string && data.mediaUrl.size() <= 500
        && data.mediaType is string && data.mediaType in ['image', 'video']
        && data.promptText is string && data.promptText.size() >= 10 && data.promptText.size() <= 4000
        && data.authorId is string && isValidId(data.authorId)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFavoriteItem(data, promptId) {
      return data.keys().hasAll(['promptId', 'userId', 'savedAt'])
        && data.keys().hasOnly(['promptId', 'userId', 'savedAt'])
        && data.promptId is string && isValidId(data.promptId) && data.promptId == promptId
        && data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid
        && data.savedAt is timestamp;
    }

    function isValidGenerationItem(data) {
      return data.keys().hasAll(['userId', 'generatorType', 'title', 'outputText', 'createdAt'])
        && data.keys().hasOnly(['userId', 'generatorType', 'title', 'outputText', 'createdAt'])
        && data.userId is string && isValidId(data.userId) && data.userId == request.auth.uid
        && data.generatorType is string && data.generatorType in ['video', 'headlines', 'custom']
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 120
        && data.outputText is string && data.outputText.size() >= 5 && data.outputText.size() <= 6000
        && data.createdAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();

      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == userId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId)
            && incoming().uid == request.auth.uid
            && incoming().email == request.auth.token.email
            && (
              (incoming().planStatus == 'pending' && incoming().accessExpiresAt <= request.time) ||
              (
                hasPreapprovedPurchase()
                && incoming().planStatus == 'active'
                && incoming().accessExpiresAt <= request.time + duration.value(91, 'd')
              )
            )
          )
        );

      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isValidUserProfile(incoming())
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (
            isOwner(userId) && (
              incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt']) ||
              (
                hasPreapprovedPurchase()
                && (existing().planStatus != 'active' || existing().accessExpiresAt <= request.time)
                && incoming().diff(existing()).affectedKeys().hasOnly(['planStatus', 'accessExpiresAt', 'updatedAt'])
                && incoming().planStatus == 'active'
                && incoming().accessExpiresAt <= request.time + duration.value(91, 'd')
              )
            )
          )
        );

      allow delete: if isAdmin() && isValidId(userId);

      match /favorites/{promptId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(promptId) && isOwner(userId) && hasActiveSubscription();
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid && hasActiveSubscription();
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(promptId)
          && isOwner(userId)
          && hasActiveSubscription()
          && exists(/databases/$(database)/documents/users/$(userId))
          && exists(/databases/$(database)/documents/prompts/$(promptId))
          && isValidFavoriteItem(incoming(), promptId)
          && incoming().savedAt == request.time;
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(promptId) && isOwner(userId) && hasActiveSubscription();
      }

      match /generations/{genId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(genId) && isOwner(userId) && hasActiveSubscription();
        allow list: if isSignedIn() && resource.data.userId == request.auth.uid && hasActiveSubscription();
        allow create: if isVerifiedUser()
          && isValidId(userId)
          && isValidId(genId)
          && isOwner(userId)
          && hasActiveSubscription()
          && exists(/databases/$(database)/documents/users/$(userId))
          && isValidGenerationItem(incoming())
          && incoming().createdAt == request.time;
        allow delete: if isVerifiedUser() && isValidId(userId) && isValidId(genId) && isOwner(userId) && hasActiveSubscription();
      }
    }

    match /approved_purchases/{emailKey} {
      allow get: if isVerifiedUser() && isValidId(emailKey) && (isAdmin() || emailKey == emailKeyForAuth());
      allow list: if isAdmin();
      allow create: if isAdmin()
        && isValidId(emailKey)
        && isValidApprovedPurchase(incoming())
        && incoming().grantedBy == request.auth.uid
        && incoming().createdAt == request.time;
      allow update: if isAdmin()
        && isValidId(emailKey)
        && isValidApprovedPurchase(incoming())
        && incoming().grantedBy == request.auth.uid;
      allow delete: if isAdmin() && isValidId(emailKey);
    }

    match /prompts/{promptId} {
      allow get: if isSignedIn() && isValidId(promptId) && hasActiveSubscription();
      allow list: if isSignedIn() && hasActiveSubscription();
      allow create: if isAdmin()
        && isValidId(promptId)
        && isValidPromptItem(incoming())
        && incoming().authorId == request.auth.uid
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(promptId)
        && isValidPromptItem(incoming())
        && incoming().authorId == existing().authorId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'category', 'typeLabel', 'mediaUrl', 'mediaType', 'promptText', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(promptId);
    }

    match /admins/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if false;
      allow write: if false;
    }
  }
}
