<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090909">
<title>Bia Prompts IA</title>
<style>
:root{--bg:#080808;--panel:#121212;--red:#f12b3d;--text:#f6f3f3;--muted:#9b9698;--line:#292326}
*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 50% -15%,#3b0911 0,transparent 40%),var(--bg);color:var(--text);font-family:Arial,sans-serif;min-height:100vh}
button,input,textarea,select{font:inherit}button{cursor:pointer}.hidden{display:none!important}
.page{max-width:1180px;margin:auto;padding:22px 18px 100px}
header{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-bottom:22px}
.brand{display:flex;align-items:center;gap:12px}.logo{width:44px;height:44px;border-radius:14px;background:linear-gradient(145deg,#ff4858,#9c071a);display:grid;place-items:center;font-size:22px;font-weight:900}
.brand h1{font-size:19px;margin:0}.brand small{display:block;color:var(--muted);font-size:10px;letter-spacing:2px;margin-top:3px}
button{border:0;border-radius:10px;padding:11px 14px;font-weight:bold}.primary{background:linear-gradient(100deg,#f12b3d,#b50e22);color:white}.secondary{background:#21191c;border:1px solid #40262d;color:#f2c8cd}.mutedbtn{background:#292326;color:white}
h2{font-size:clamp(26px,5vw,40px);margin:10px 0}h2 span{color:var(--red)}p{color:var(--muted);line-height:1.5}
.panel{background:linear-gradient(180deg,#181516,#101010);border:1px solid var(--line);border-radius:18px;padding:20px;margin:16px 0}
.auth-wrap{min-height:100vh;display:grid;place-items:center;padding:18px}.auth-card{width:min(480px,100%);background:#151214;border:1px solid #503038;border-radius:20px;padding:24px;box-shadow:0 20px 80px #0008}
.price{font-size:38px;font-weight:900;color:#fff;margin:12px 0}.price small{font-size:14px;color:var(--muted);font-weight:400}
.field{display:grid;gap:7px;margin:13px 0}.field label{font-size:12px;color:#d5cdd0;font-weight:bold}.field input,.field textarea,.field select{width:100%;padding:13px;background:#0d0c0c;border:1px solid #382d31;border-radius:10px;color:white;outline:none}.field textarea{min-height:130px;resize:vertical}
.full{width:100%}.small{font-size:11px}.muted{color:var(--muted)}.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.between{justify-content:space-between}
.search input{width:100%;padding:15px;border-radius:13px;background:#141214;border:1px solid #30262a;color:white}
.filters{display:flex;gap:8px;overflow:auto;padding:12px 0}.chip{white-space:nowrap;border:1px solid #30282b;background:#141214;color:#c9c2c4;border-radius:30px;padding:9px 14px;font-size:12px}.chip.active{background:var(--red);color:white}
.grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}.card{border:1px solid var(--line);background:linear-gradient(180deg,#181516,#101010);border-radius:17px;overflow:hidden}.thumb{height:210px;background:#242022;position:relative}.thumb img,.thumb video{width:100%;height:100%;object-fit:cover}.tag{position:absolute;top:10px;left:10px;background:#141014d9;border-radius:30px;padding:5px 9px;font-size:10px}.card-body{padding:12px}.card h4{font-size:14px;margin:8px 0 12px;min-height:32px}.actions{display:grid;gap:7px}.actions button{font-size:11px;padding:10px 8px}
.nav{display:flex;justify-content:space-around;gap:6px;padding:12px 5px;position:fixed;bottom:0;left:0;right:0;background:#0d0b0cf0;border-top:1px solid #302529;z-index:5}.nav button{background:none;color:#aaa;font-size:10px;display:grid;gap:4px}.nav button span{font-size:19px}.nav button.active{color:#ff5364}
.toast{position:fixed;left:50%;bottom:88px;transform:translate(-50%,15px);background:white;color:#111;padding:11px 17px;border-radius:30px;font-size:12px;font-weight:bold;opacity:0;transition:.25s;z-index:20}.toast.show{opacity:1;transform:translate(-50%,0)}
.modal{display:none;position:fixed;inset:0;background:#000b;z-index:10;align-items:center;justify-content:center;padding:16px}.modal.show{display:flex}.dialog{width:min(600px,100%);max-height:90vh;overflow:auto;background:#151214;border:1px solid #503038;border-radius:18px;padding:20px}
.detail-prompt{white-space:pre-wrap;background:#0c0b0b;border:1px solid #32292c;border-radius:12px;padding:13px;font-size:12px;line-height:1.6;margin:12px 0}
.progress{height:10px;background:#332d30;border-radius:30px;overflow:hidden}.progress>div{height:100%;background:#22a06b;width:100%}
.admin-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.admin-tile{padding:16px;background:#201a1d;border:1px solid #3a2a30;border-radius:13px}
@media(max-width:850px){.grid{grid-template-columns:repeat(3,minmax(0,1fr))}}@media(max-width:600px){.page{padding:15px 13px 100px}.grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.thumb{height:180px}.auth-card{padding:19px}}@media(max-width:370px){.thumb{height:150px}}
</style>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
</head>
<body>

